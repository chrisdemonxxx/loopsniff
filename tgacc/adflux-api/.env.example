# =============================================================================
# AdFlux API — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/adflux

# JWT Authentication
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# NOWPayments (both naming conventions for compat)
NOWPAY_API_KEY=your-nowpayments-api-key
NOWPAY_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Ollama Cloud (AI responder)
OLLAMA_CLOUD_KEY=your-ollama-cloud-key
OLLAMA_CLOUD_URL=https://api.ollamacloud.com/v1
OLLAMA_MODEL=llama3.1:8b

# Telegram Bot Alerts
TG_BOT_TOKEN=your-telegram-bot-token
TG_ALERT_CHAT_ID=your-telegram-chat-id

# Ntfy Alerts
NTFY_TOPIC=adflux-alerts
NTFY_URL=https://ntfy.sh

# Outreach DB
OUTREACH_DB_PATH=./bulk-account-creator/outreach/data/outreach.db

# AdFlux Media Channel
ADFLUX_CHANNEL_ID=your-adflux-channel-id
ADFLUX_CHANNEL_INVITE=https://t.me/your_channel_invite
