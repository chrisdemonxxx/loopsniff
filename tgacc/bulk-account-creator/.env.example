# =============================================================================
# Bulk Account Creator — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ── SMS-Man (optional – blocked by Cloudflare, enter codes manually) ──
SMS_MAN_API_KEY=your-sms-man-api-key

# ── Roxy Browser API ─────────────────────────
ROXY_API_KEY=your-roxy-api-key
ROXY_API_HOST=http://127.0.0.1:50000

# ── Proxy-Seller (optional – can enter proxy manually) ──
PROXY_SELLER_KEY=your-proxy-seller-api-key

# ── Rate Limiting ─────────────────────────────
SMS_RATE_LIMIT=2
ROXY_RATE_LIMIT=5
PROXY_RATE_LIMIT=5

# ── Account Creation Defaults ────────────────
DEFAULT_COUNTRY=us
SMS_TIMEOUT=300
MAX_RETRIES=3
BATCH_SIZE=10
CONCURRENT_ACCOUNTS=3

# ── Telegram API Credentials ─────────────────
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# ── AdFlux Channel ───────────────────────────
ADFLUX_CHANNEL_ID=your-adflux-channel-id

# ── Proxy-Seller Residential ─────────────────
PROXY_HOST=your-proxy-host
PROXY_PORT=your-proxy-port
PROXY_PASSWORD=your-proxy-password
PROXY_SELLER_PASS=your-proxy-seller-pass
PROXY_SELLER_USER=your-proxy-seller-user
PROXY_SELLER_HOST=res.proxy-seller.com
PROXY_SELLER_PORT=10000

# ── Notion CRM ───────────────────────────────
NOTION_TOKEN=your-notion-token
NOTION_DB_ID=your-notion-db-id

# ── Google Sheets CRM ────────────────────────
GOOGLE_CREDS_PATH=path/to/google-service-account.json

# ── Telegram Bot (for alerts) ────────────────
ADFLUX_BOT_TOKEN=your-telegram-bot-token
ADFLUX_ADMIN_CHAT_ID=your-admin-chat-id
