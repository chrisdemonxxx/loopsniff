# Bulk Account Creator Configuration

# ── Roxy Browser ──────────────────────────────
ROXY_API_KEY=your_roxy_api_key_here
ROXY_API_HOST=http://127.0.0.1:50000

# ── SMS-Man (optional – blocked by Cloudflare, enter codes manually) ──
SMS_MAN_API_KEY=your_sms_man_api_key_here

# ── Proxy-Seller (optional – can enter proxy manually) ──
PROXY_SELLER_KEY=your_proxy_seller_api_key_here

# ── Defaults ──────────────────────────────────
DEFAULT_COUNTRY=us
SMS_TIMEOUT=300
MAX_RETRIES=3
BATCH_SIZE=10
CONCURRENT_ACCOUNTS=3
