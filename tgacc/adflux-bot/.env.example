# =============================================================================
# AdFlux Bot — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Telegram Bot token (from @BotFather)
BOT_TOKEN=your-telegram-bot-token

# Telegram chat ID for admin notifications
ADMIN_CHAT_ID=your-admin-chat-id

# Telegram username of the bot admin
ADMIN_USERNAME=your-admin-username

# Telegram username of the bot itself
BOT_USERNAME=your-bot-username

# Ollama / LLM API endpoint
OLLAMA_URL=http://localhost:11434

# Ollama API key (if using a cloud provider)
OLLAMA_API_KEY=your-ollama-api-key

# LLM model name
OLLAMA_MODEL=llama3.1:8b

# AdFlux API base URL (backend)
API_BASE_URL=http://localhost:8099

# AdFlux API bearer token (leave empty if auth is disabled)
API_TOKEN=
