# =============================================================================
# AdFlux RAG — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Path to the ChromaDB persistent storage directory
CHROMA_DB_PATH=./chroma_db

# Embedding model name for vector embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Data source paths (directories or files for RAG ingestion)
BHW_DIR=./data/bhw
AW_DIR=./data/aw
HACKFORUMS_DB=./data/hackforums.db
EXPLOIT_CSV=./data/exploits.csv
