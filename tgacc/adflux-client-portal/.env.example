# =============================================================================
# AdFlux Client Portal — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8099

# NextAuth secret for session signing (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-random-auth-secret

# NextAuth base URL (must match the app's public URL)
NEXTAUTH_URL=http://localhost:3000
