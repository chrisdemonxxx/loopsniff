# =============================================================================
# Kliqboost Stats API — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# API Key for authentication (required)
STATS_API_KEY=change-me-to-a-random-api-key

# Sync key matching the main API
STATS_SYNC_KEY=change-me-to-a-random-sync-key

# Comma-separated CORS origins (optional, defaults to kliqboost/bisonclick domains + localhost)
# STATS_ALLOWED_ORIGINS=https://admin.kliqboost.online,https://admin.kliqboost.com,http://localhost:3001

# Main API URL for sync
KLIQBOOST_API_URL=https://kliqboost-api.onrender.com
