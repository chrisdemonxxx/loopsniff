# =============================================================================
# Kliqboost Userbot (Autoresponder) — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Telegram session (base64-encoded StringSession)
TG_SESSION_B64=your-base64-encoded-session

# Telegram API credentials
TG_API_ID=your-api-id
TG_API_HASH=your-api-hash

# Telegram 2FA cloud password (if account has 2FA)
TG_CLOUD_PASSWORD=

# Ollama Cloud LLM
OLLAMA_CLOUD_URL=https://api.ollamacloud.com/v1
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key
OLLAMA_MODEL=kimi-k2:1t

# Kliqboost API
API_BASE_URL=http://localhost:8099

# Sync key for internal heartbeat/communication
STATS_SYNC_KEY=change-me-to-a-random-sync-key

# Admin notifications (Telegram bot)
ADMIN_BOT_TOKEN=your-admin-bot-token
ADMIN_CHAT_ID=your-admin-chat-id

# Crypto wallet addresses
BTC_ADDRESS=your-btc-address
ETH_ADDRESS=your-eth-address
USDT_ERC20_ADDRESS=your-usdt-erc20-address

# Security guardrail mode (enabled/disabled/paranoid)
SECURITY_GUARDRAIL_MODE=disabled

# Proxy (optional)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# RAG path
RAG_PATH=/home/cjs/kliqboost/rag
