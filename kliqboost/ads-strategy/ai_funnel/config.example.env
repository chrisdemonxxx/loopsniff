# ═══════════════════════════════════════════════════════════════════════════
# AI FUNNEL — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values:
#   cp config.example.env .env

# ── Telegram Bot API (Qualification Bot) ─────────────────────────────────
# Create via @BotFather — this is the public-facing bot users interact with
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername

# ── Telegram MTProto (AI Userbot) ────────────────────────────────────────
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=10840
TELEGRAM_API_HASH=33c45224029d59cb3ad0c16134215aeb
USERBOT_PHONE=+16574472999
USERBOT_SESSION_NAME=tg_funnel_userbot

# ── Channel Configuration ────────────────────────────────────────────────
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=YourChannelUsername

# ── LLM Configuration ───────────────────────────────────────────────────
# Ollama Cloud (default — kimi-k2:1t, free tier)
OLLAMA_URL=https://ollama.com/v1/chat/completions
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=kimi-k2:1t

# Fallback: Local Qwen3.5-397B via Baseten proxy
# OLLAMA_URL=http://localhost:4000/v1/chat/completions
# OLLAMA_MODEL=qwen3.5-397b
# OLLAMA_API_KEY=not_needed_for_local

# ── Proxy (Residential — required for userbot) ──────────────────────────
PROXY_TYPE=http
PROXY_HOST=res.proxy-seller.com
PROXY_PORT=10000
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# ── Admin Notifications ─────────────────────────────────────────────────
ADMIN_BOT_TOKEN=your_admin_bot_token
ADMIN_CHAT_ID=your_admin_chat_id

# ── RAG System ──────────────────────────────────────────────────────────
RAG_PATH=/home/cjs/tgacc/kliqboost/rag
OUTREACH_PATH=/home/cjs/tgacc/bulk-account-creator

# ── Safety Limits ───────────────────────────────────────────────────────
MAX_REPLIES_PER_HOUR=8
MAX_REPLIES_PER_DAY=50
MIN_REPLY_DELAY=5
MAX_REPLY_DELAY=25
TYPING_SPEED_MIN=3.0
TYPING_SPEED_MAX=6.0
THINK_DELAY_MIN=1.0
THINK_DELAY_MAX=5.0

# ── Database ────────────────────────────────────────────────────────────
DB_PATH=./funnel_leads.db

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./funnel.log
