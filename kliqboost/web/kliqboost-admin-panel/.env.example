# =============================================================================
# Kliqboost Admin Panel — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# NextAuth secret for session signing (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-random-auth-secret

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8099

# -----------------------------------------------------------------------------
# Obfuscated path gate (production hardening — see DEPLOYMENT.md "Admin panel")
# -----------------------------------------------------------------------------
# When set, middleware returns a flat 404 for any request whose pathname does not
# start with this prefix. The login page then lives at ${ADMIN_REQUIRED_PATH_PREFIX}/login
# and dashboard at ${ADMIN_REQUIRED_PATH_PREFIX}/dashboard. Pick an unguessable random
# segment, e.g. /_internal/console-7f3a9c. Leave empty in local dev.
ADMIN_REQUIRED_PATH_PREFIX=

# NextAuth canonical URL — only set in production when you have chosen a public host
# (see ADMIN_PUBLIC_HOST / ADMIN_PUBLIC_PATH in infra/gcp/deploy-cloud-run.sh). Include
# the path prefix, e.g. https://console-7f3a.kliqboost.store/_internal/console-7f3a
# NEXTAUTH_URL=
